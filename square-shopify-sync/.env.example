# --- Square (source of truth for catalog + inventory) ---
# Create at developer.squareup.com — an access token with ITEMS_READ and
# INVENTORY_READ scopes is enough; this script never writes to Square.
SQUARE_ACCESS_TOKEN=
# Pre-filled with the Shia Baby location discovered when this was built
# (4400 N 23rd St, McAllen, TX). Confirm it's still correct, or replace it.
SQUARE_LOCATION_ID=LQ84FEHVKM6A5
# https://developer.squareup.com/reference/square — omit for production
SQUARE_ENVIRONMENT=production

# --- Shopify (destination — the online store) ---
# The *.myshopify.com admin domain, not the custom domain (shiababyboutique.com
# is the storefront's custom domain; the Admin API needs the myshopify.com one).
# Find it under Shopify Admin → Settings → Domains.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Create a custom app under Shopify Admin → Settings → Apps → Develop apps,
# with scopes: read_products, write_products, read_inventory, write_inventory
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Pre-filled with the store's single location discovered when this was built.
# Confirm it's still correct, or replace it (Admin → Settings → Locations).
SHOPIFY_LOCATION_ID=gid://shopify/Location/89166151893

# --- Behavior ---
# true = compute and log every change without writing anything to Shopify.
DRY_RUN=false
