# --- Supabase (create a project at supabase.com, run supabase/migrations/0001_init.sql) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (Resend). Optional — order emails are logged and skipped if unset. ---
RESEND_API_KEY=
EMAIL_FROM="Shia Baby <hello@shiababy.com>"
ADMIN_NOTIFICATION_EMAIL=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated list of origins allowed to call this API cross-origin
# (needed if the storefront frontend is deployed separately from this
# backend). Use "*" to allow any origin for the public read endpoints.
ALLOWED_ORIGINS=http://localhost:3000

# --- Pricing rules (Section 10/11 of the store blueprint) ---
FREE_SHIPPING_THRESHOLD=75
FLAT_SHIPPING_RATE=6.95
GIFT_WRAP_PRICE=8
# Flat sales-tax rate applied to (discounted subtotal + gift wrap), e.g. 0.0825 for 8.25%.
# This is a placeholder for a single-jurisdiction estimate — wire up Stripe
# Tax or TaxJar before relying on this for real multi-state compliance.
TAX_RATE=0
